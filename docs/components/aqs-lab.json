{
  "title": "AQS 与 ReentrantLock：抢不到锁会怎样？",
  "intro": "观察线程抢锁、入队、唤醒、再次争抢，以及“可重入”为什么不死锁。",
  "modes": [
    {
      "id": "contention",
      "name": "锁竞争 / 等待队列",
      "subtitle": "两线程竞争同一把 ReentrantLock，先演示一种成功排队的路径。"
    },
    {
      "id": "reentrant",
      "name": "可重入锁计数",
      "subtitle": "同一个线程连续 lock() 两次，state 计数如何变化？"
    },
    {
      "id": "barging",
      "name": "非公平插队",
      "subtitle": "非公平锁下，新来的线程可能先获得锁；不是必然插队。"
    }
  ],
  "scenarios": {
    "contention": [
      {
        "headline": "空闲：没有持有者",
        "note": "概念上 ReentrantLock 独占持有者为空，state=0。",
        "cards": [
          {
            "label": "锁持有者",
            "value": "无人",
            "detail": "state=0"
          },
          {
            "label": "AQS 等待队列",
            "value": "空",
            "detail": "没有阻塞的竞争者"
          },
          {
            "label": "线程 B",
            "value": "准备获取",
            "detail": "lock()"
          }
        ],
        "focus": 0,
        "code": ""
      },
      {
        "headline": "A 获得锁",
        "note": "A 调用 lock 成功；state 从 0 变成 1。",
        "cards": [
          {
            "label": "锁持有者",
            "value": "线程 A",
            "detail": "state=1"
          },
          {
            "label": "AQS 等待队列",
            "value": "空",
            "detail": "—"
          },
          {
            "label": "线程 B",
            "value": "尚未获取",
            "detail": "—"
          }
        ],
        "focus": 0,
        "code": "lock.lock(); // A"
      },
      {
        "headline": "B 争锁失败，进入等待队列",
        "note": "B 的获取尝试失败；经 AQS 入队并按条件 park 等待，不应在应用代码中自旋死等。",
        "cards": [
          {
            "label": "锁持有者",
            "value": "线程 A",
            "detail": "继续处理临界区"
          },
          {
            "label": "AQS 等待队列",
            "value": "head → B",
            "detail": "简化队列示意"
          },
          {
            "label": "线程 B",
            "value": "等待中",
            "detail": "可能 park"
          }
        ],
        "focus": 1,
        "code": "lock.lock(); // B 竞争未成功"
      },
      {
        "headline": "A 解锁，允许后续竞争",
        "note": "A unlock 使 state 归零；AQS 可以唤醒合适的后继等待者。",
        "cards": [
          {
            "label": "锁持有者",
            "value": "无人",
            "detail": "state=0"
          },
          {
            "label": "AQS 等待队列",
            "value": "head → B",
            "detail": "可被唤醒"
          },
          {
            "label": "线程 B",
            "value": "被通知",
            "detail": "但尚未保证拿到锁"
          }
        ],
        "focus": 2,
        "code": "lock.unlock(); // A"
      },
      {
        "headline": "B 再次尝试，获得锁",
        "note": "被唤醒 ≠ 锁已自动转交；B 重新检查获取条件，成功后才是持有者。",
        "cards": [
          {
            "label": "锁持有者",
            "value": "线程 B",
            "detail": "state=1"
          },
          {
            "label": "AQS 等待队列",
            "value": "B 出队",
            "detail": "已成功获取"
          },
          {
            "label": "线程 B",
            "value": "执行临界区",
            "detail": "真正拿到锁"
          }
        ],
        "focus": 0,
        "code": ""
      },
      {
        "headline": "B 解锁，恢复空闲",
        "note": "锁的获取与释放必须匹配，推荐 try/finally。",
        "cards": [
