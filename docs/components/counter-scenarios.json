{
  "modes": [
    {
      "id": "volatile",
      "name": "volatile count++",
      "subtitle": "读得到更新，不代表两个人不会同时改同一份旧值"
    },
    {
      "id": "atomic",
      "name": "AtomicInteger",
      "subtitle": "一个线程更新成功后，另一个线程必须基于新值重试"
    },
    {
      "id": "lock",
      "name": "synchronized",
      "subtitle": "同一把锁让两个线程依次完成整个读—改—写"
    }
  ],
  "scenarios": {
