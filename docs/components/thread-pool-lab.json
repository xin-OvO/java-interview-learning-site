{
  "title": "线程池 execute()：任务会流向哪里？",
  "intro": "同样是提交一个任务，为什么有时创建线程，有时先进队列，还有时直接拒绝？",
  "modes": [
    {
      "id": "bounded",
      "name": "有界队列 · 4 个任务",
      "subtitle": "core=1、max=2、queue容量=1；为便于观察，工作任务先保持忙碌。"
    },
    {
      "id": "unbounded",
      "name": "无界队列现象",
      "subtitle": "core=1、max=3、LinkedBlockingQueue 默认理论容量极大；队列会优先接收。"
    },
    {
      "id": "shutdown",
      "name": "关闭后的任务",
      "subtitle": "调用 shutdown() 后，不再接受新任务；已提交任务按规则继续处理。"
    }
  ],
  "scenarios": {
    "bounded": [
      {
        "headline": "创建线程池，还没有任务",
        "note": "核心线程不一定预先创建，默认一般按需创建。",
        "cards": [
          {
            "label": "核心工作线程",
            "value": "0 / 1",
            "detail": "尚未启动"
          },
          {
            "label": "等待队列",
            "value": "0 / 1",
            "detail": "空"
          },
          {
            "label": "非核心扩展线程",
            "value": "0 / 1",
            "detail": "尚未启动"
          },
          {
            "label": "提交结果",
            "value": "准备中",
            "detail": "core=1 max=2"
          }
        ],
        "focus": 0,
        "code": ""
      },
      {
        "headline": "任务 T1：先创建核心线程",
        "note": "当前 worker 数 0 小于 corePoolSize 1，优先 addWorker(T1,true)。",
        "cards": [
          {
            "label": "核心工作线程",
            "value": "1 / 1",
            "detail": "正在处理 T1"
          },
          {
            "label": "等待队列",
            "value": "0 / 1",
            "detail": "空"
          },
          {
            "label": "非核心扩展线程",
            "value": "0 / 1",
            "detail": "空"
          },
          {
            "label": "提交结果",
            "value": "T1 接收",
            "detail": "开始执行"
          }
        ],
        "focus": 0,
        "code": "execute(T1);  // 新建核心 worker"
      },
      {
        "headline": "任务 T2：入队，而不是立刻扩容",
        "note": "核心线程数已到 core；工作队列仍有空间，因此 offer(T2) 成功。",
        "cards": [
          {
            "label": "核心工作线程",
            "value": "1 / 1",
            "detail": "T1 仍忙"
          },
          {
            "label": "等待队列",
            "value": "1 / 1",
            "detail": "队列中 T2"
          },
          {
            "label": "非核心扩展线程",
            "value": "0 / 1",
            "detail": "未启动"
          },
          {
            "label": "提交结果",
            "value": "T2 接收",
            "detail": "等待执行"
          }
        ],
        "focus": 1,
        "code": "execute(T2);  // 入队"
      },
      {
        "headline": "任务 T3：队列满，才尝试扩容",
        "note": "T1 忙、队列满，worker 数 1 小于 maximumPoolSize 2，于是新建第二个 worker。",
        "cards": [
          {
            "label": "核心工作线程",
            "value": "1 / 1",
            "detail": "T1 忙"
          },
          {
            "label": "等待队列",
            "value": "1 / 1",
            "detail": "T2 等待"
          },
          {
            "label": "非核心扩展线程",
            "value": "1 / 1",
            "detail": "执行 T3"
          },
          {
            "label": "提交结果",
            "value": "T3 接收",
            "detail": "创建扩展线程"
          }
        ],
        "focus": 2,
        "code": ""
      },
      {
        "headline": "任务 T4：队列满且线程达到 max",
        "note": "不能再入队，也不能再扩容。AbortPolicy 抛出 RejectedExecutionException。",
        "cards": [
          {
            "label": "核心工作线程",
            "value": "1 / 1",
            "detail": "T1 忙"
          },
          {
            "label": "等待队列",
            "value": "1 / 1",
            "detail": "T2 等待"
          },
          {
            "label": "非核心扩展线程",
            "value": "1 / 1",
            "detail": "T3 忙"
          },
          {
            "label": "提交结果",
            "value": "T4 被拒绝",
            "detail": "AbortPolicy 抛异常"
          }
        ],
        "focus": 3,
        "code": "execute(T4); // RejectedExecutionException"
      },
      {
        "headline": "T1/T3 结束后，线程可以取队列任务",
        "note": "工作线程空闲后会继续尝试从队列获取 T2；不是 T2 自动创建额外线程。",
        "cards": [
          {
            "label": "核心工作线程",
            "value": "可用",
            "detail": "可能取走 T2"
          },
          {
            "label": "等待队列",
            "value": "0 / 1",
            "detail": "T2 被取走"
          },
          {
            "label": "非核心扩展线程",
            "value": "可用",
            "detail": "空闲后受 keepAlive 影响"
          },
          {
            "label": "提交结果",
            "value": "T1/T2/T3 可完成",
            "detail": "T4 没有执行"
          }
        ],
        "focus": 1,
        "code": ""
      }
    ],
    "unbounded": [
